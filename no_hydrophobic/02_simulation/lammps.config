units           lj
dimension       3
boundary        f f f
atom_style      full

read_data       cyl_50.data
comm_modify     cutoff 3.0
log             logfile_50.txt

# --------------------------------------------------
# Groups
# --------------------------------------------------

group anchor type 1
group polymer type  2 3
group shell type 4
group fixed union anchor shell 

# --------------------------------------------------
# Freeze shell + anchors
# --------------------------------------------------

fix freeze fixed setforce 0.0 0.0 0.0
velocity fixed set 0.0 0.0 0.0

# --------------------------------------------------
# Hard-sphere-like repulsion (WCA)
# --------------------------------------------------

pair_style      lj/cut 1.122462048



# Shell interactions
pair_coeff 1 2 1.0 1.0 1.122462048
pair_coeff 2 2 1.0 1.0 1.122462048
pair_coeff 1 1 1.0 1.0 1.122462048
pair_coeff 1 3 1.0 1.0 1.122462048
pair_coeff 2 3 1.0 1.0 1.122462048
pair_coeff 3 3 1.0 1.0 1.122462048
pair_coeff 1 4 1.0 1.0 1.122462048
pair_coeff 2 4 1.0 1.0 1.122462048
pair_coeff 3 4 1.0 1.0 1.122462048
pair_coeff 4 4 1.0 1.0 1.122462048
pair_modify shift yes

# --------------------------------------------------
# Bonds
# --------------------------------------------------

bond_style harmonic
bond_coeff 1 100.0 1.0

special_bonds lj 0.0 1.0 1.0

# --------------------------------------------------
# Angles
# --------------------------------------------------

angle_style harmonic

angle_coeff 1 10.0 180.0
angle_coeff 2 10.0 180.0
angle_coeff 3 7.0 180.0
angle_coeff 4 5.0 180.0
angle_coeff 5 0.0 180.0

# --------------------------------------------------
# Neighbors
# --------------------------------------------------

neighbor 0.3 bin
neigh_modify delay 0 every 1 check yes

# --------------------------------------------------
# Minimization
# --------------------------------------------------

thermo 100
thermo_style custom step temp pe ke etotal press

minimize 1.0e-8 1.0e-8 10000 100000

# --------------------------------------------------
# Velocities
# --------------------------------------------------

velocity polymer create 1.0 12345 mom yes rot yes

# --------------------------------------------------
# Dynamics
# --------------------------------------------------

fix nvt_polymer polymer nvt temp 1.0 1.0 1.0

timestep 0.005

# --------------------------------------------------
# Output
# --------------------------------------------------

dump traj all dcd 10000 dump_50.dcd

thermo 10000

run 100000000

write_restart dump_50.restart

print "Simulation completed"
